# Make Over Indonesia Landing Page - Environment Variables Example
# Salin file ini menjadi .env dan isi nilai yang sesuai

# Konfigurasi Formulir (opsional - untuk integrasi layanan formulir)
# Jika menggunakan Formspree:
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Jika menggunakan EmailJS:
# VITE_EMAILJS_SERVICE_ID=your_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Catatan: Jangan pernah menyimpan credential rahasia dengan prefix VITE_
# karena akan terekspos ke browser.
